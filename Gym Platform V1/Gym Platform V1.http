### Gym Management System - Complete HTTP Test Suite
### Base Configuration
@baseUrl = http://localhost:5077
@httpsBaseUrl = https://localhost:7093

### Variables for tokens (captured from login responses)
@adminToken = 
@gymOwnerToken = 
@trainerToken = 

### Variables for IDs (captured from responses)
@ownerId = 
@gymId = 
@trainerId = 
@memberId = 
@applicationId = 

####################################################################################
### SECTION 1: ADMIN AUTHENTICATION
####################################################################################

### 1.1 Admin Login
# Expected: 200 OK, returns token in response.token
POST {{baseUrl}}/api/admin/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "Admin@123"
}

@adminToken = {{response.body.token}}

###

####################################################################################
### SECTION 2: GYMOWNER APPLICATION FLOW (PUBLIC)
####################################################################################

### 2.1 Submit GymOwner Application (Public - No Auth Required)
# Expected: 201 Created
POST {{baseUrl}}/api/gym-owner-applications
Content-Type: application/json

{
  "fullName": "John Doe",
  "userName": "johndoe_owner",
  "email": "john@example.com",
  "phoneNumber": "01012345678",
  "password": "Password@123",
  "gymName": "Fitness Center Pro",
  "gymAddress": "123 Main Street, City",
  "gymPhoneNumber": "01087654321"
}

@applicationId = {{response.body.id}}

###

### 2.2 Get All Applications (Admin Only)
# Expected: 200 OK, requires Admin token
GET {{baseUrl}}/api/gym-owner-applications
Authorization: Bearer {{adminToken}}

###

### 2.3 Get Pending Applications (Admin Only)
# Expected: 200 OK, requires Admin token
GET {{baseUrl}}/api/gym-owner-applications/pending
Authorization: Bearer {{adminToken}}

###

### 2.4 Approve GymOwner Application (Admin Only)
# Expected: 204 No Content
# NOTE: Use the @applicationId captured from 2.1
POST {{baseUrl}}/api/gym-owner-applications/{{applicationId}}/approve
Authorization: Bearer {{adminToken}}

###

### 2.5 Reject GymOwner Application (Admin Only)
# Expected: 204 No Content
# NOTE: Use a different applicationId if you want to test rejection
POST {{baseUrl}}/api/gym-owner-applications/{{applicationId}}/reject
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "rejectionReason": "Insufficient information provided in application"
}

###

####################################################################################
### SECTION 3: GYMOWNER MANAGEMENT (ADMIN ONLY)
####################################################################################

### 3.1 Create GymOwner (Admin Only)
# Expected: 201 Created
POST {{baseUrl}}/api/gym-owners/create
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "Ahmed Hassan",
  "userName": "ahmedhassan",
  "email": "ahmed@fitnessgym.com",
  "phoneNumber": "01012345679",
  "password": "SecurePass@456"
}

@ownerId = {{response.body.id}}

###

### 3.2 Get All GymOwners (Admin Only)
# Expected: 200 OK
GET {{baseUrl}}/api/gym-owners
Authorization: Bearer {{adminToken}}

###

### 3.3 Get GymOwner by ID with Gyms (Admin Only)
# Expected: 200 OK
# NOTE: Use @ownerId captured from 3.1
GET {{baseUrl}}/api/gym-owners/{{ownerId}}
Authorization: Bearer {{adminToken}}

@gymId = {{response.body.gyms[0].id}}

###

####################################################################################
### SECTION 4: GYMOWNER AUTHENTICATION
####################################################################################

### 4.1 GymOwner Login
# Expected: 200 OK, returns token in response.token
POST {{baseUrl}}/api/auth/gym-owner/login
Content-Type: application/json

{
  "userName": "ahmedhassan",
  "password": "SecurePass@456"
}

@gymOwnerToken = {{response.body.token}}

###

####################################################################################
### SECTION 5: TRAINER MANAGEMENT BY GYMOWNER  
####################################################################################

### 5.1 Get All Trainers (For Authenticated GymOwner)
# Expected: 200 OK, requires GymOwner role
GET {{baseUrl}}/api/trainers
Authorization: Bearer {{gymOwnerToken}}

###

### 5.2 Get Trainers Filtered by Gym (For Authenticated GymOwner)
# Expected: 200 OK
# NOTE: Use @gymId captured from 3.3
GET {{baseUrl}}/api/trainers?gymId={{gymId}}
Authorization: Bearer {{gymOwnerToken}}

###

### 5.3 Create Trainer (GymOwner Only)
# Expected: 201 Created
# NOTE: Use @gymId captured from 3.3, GymOwner must own the gym
POST {{baseUrl}}/api/trainers/create
Authorization: Bearer {{gymOwnerToken}}
Content-Type: application/json

{
  "fullName": "Mohammed Ali",
  "userName": "moali_trainer",
  "password": "TrainerPass@789",
  "phoneNumber": "01023456789",
  "salary": 5000,
  "address": "456 Trainer Street",
  "imageUrl": "https://example.com/trainer.jpg",
  "hireDate": "2024-01-15T00:00:00Z",
  "gymId": {{gymId}}
}

@trainerId = {{response.body.id}}

###

####################################################################################
### SECTION 6: TRAINER AUTHENTICATION
####################################################################################

### 6.1 Trainer Login
# Expected: 200 OK, returns token in response.token
POST {{baseUrl}}/api/auth/trainer/login
Content-Type: application/json

{
  "userName": "moali_trainer",
  "password": "TrainerPass@789"
}

@trainerToken = {{response.body.token}}

###

####################################################################################
### SECTION 7: MEMBER MANAGEMENT BY TRAINER
####################################################################################

### 7.1 Create Member (Trainer Only)
# Expected: 201 Created
# NOTE: TrainerId is extracted from JWT token automatically
POST {{baseUrl}}/api/members
Authorization: Bearer {{trainerToken}}
Content-Type: application/json

{
  "fullName": "Fatima Ahmed",
  "phoneNumber": "01034567890"
}

@memberId = {{response.body.id}}

###

####################################################################################
### SECTION 8: NEGATIVE TESTS
####################################################################################

### 8.1 Unauthorized Request - No JWT Token
# Expected: 401 Unauthorized
GET {{baseUrl}}/api/gym-owners
Authorization: Bearer invalid_token_12345

###

### 8.2 Forbidden - Trainer trying to access Admin endpoint
# Expected: 403 Forbidden
POST {{baseUrl}}/api/gym-owners/create
Authorization: Bearer {{trainerToken}}
Content-Type: application/json

{
  "fullName": "Test User",
  "userName": "testuser",
  "email": "test@example.com",
  "phoneNumber": "01012345678",
  "password": "Test@123"
}

###

### 8.3 Forbidden - GymOwner trying to access Member endpoint
# Expected: 403 Forbidden
POST {{baseUrl}}/api/members
Authorization: Bearer {{gymOwnerToken}}
Content-Type: application/json

{
  "fullName": "Test Member",
  "phoneNumber": "01012345678"
}

###

### 8.4 Bad Request - Invalid GymId Format
# Expected: 400 Bad Request or empty list
GET {{baseUrl}}/api/trainers?gymId=invalid
Authorization: Bearer {{gymOwnerToken}}

###

### 8.5 Bad Request - Missing Required Fields
# Expected: 400 Bad Request
POST {{baseUrl}}/api/members
Authorization: Bearer {{trainerToken}}
Content-Type: application/json

{
  "fullName": ""
}

###

####################################################################################
### SECTION 9: COMPLETE BUSINESS FLOW TEST SEQUENCES
####################################################################################

### FLOW A: Admin Approving GymOwner Application
# Step 1: Admin Login (Section 1.1)
# Step 2: Submit Application (Section 2.1) 
# Step 3: Get Pending Applications (Section 2.3)
# Step 4: Approve Application (Section 2.4)
# NOTE: Execute these in order to test the complete flow

###

### FLOW B: GymOwner Managing Trainers
# Step 1: Admin creates GymOwner (Section 3.1)
# Step 2: Get GymOwner details with Gyms (Section 3.3)
# Step 3: GymOwner Login (Section 4.1)
# Step 4: Get all trainers (Section 5.1)
# Step 5: Create trainer (Section 5.3)
# Step 6: Get trainers filtered by gym (Section 5.2)
# NOTE: Execute these in order to test the complete flow

###

### FLOW C: Trainer Creating Members
# Step 1: Trainer Login (Section 6.1)
# Step 2: Create member (Section 7.1)
# NOTE: Requires trainer account to be created first via Flow B

###

####################################################################################
### ADDITIONAL NOTES
####################################################################################

### How to use this file:
### 1. Keep this file open in Visual Studio or VS Code
### 2. Use Ctrl+Alt+R (or Cmd+Alt+R on Mac) to send requests
### 3. Tokens and IDs are automatically captured using @variable syntax
### 4. Follow the flow sections to test complete business scenarios
### 5. Use negative tests to verify error handling

### Variable Reference:
### @adminToken         - JWT token for Admin role
### @gymOwnerToken      - JWT token for GymOwner role
### @trainerToken       - JWT token for Trainer role
### @ownerId            - ID of created GymOwner
### @gymId              - ID of Gym from GymOwner's details  
### @trainerId          - ID of created Trainer
### @memberId           - ID of created Member
### @applicationId      - ID of GymOwner Application

### Response Codes:
### 200 OK              - Successful GET/POST/PUT that returns data
### 201 Created         - Successful resource creation
### 204 No Content      - Successful operation that returns no body (e.g., Approve/Reject)
### 400 Bad Request     - Validation error (invalid DTO, missing fields)
### 401 Unauthorized    - Invalid/missing JWT token
### 403 Forbidden       - Authenticated but insufficient role
### 404 Not Found       - Resource not found
### 409 Conflict        - Duplicate username, email, or phone
### 500 Server Error    - Unexpected server error

